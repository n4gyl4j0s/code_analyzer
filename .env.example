# Example .env file for local development
# DO NOT put production secrets or API keys in this file if it will be committed.
# Add your real keys to a non-committed local `.env` file (and add `.env` to .gitignore).

# LLM server URL (example)
LLM_API_URL_L=http://localhost:1234/v1

# LLM model name (example)
LLM_MODEL_NAME=phi-4-14b-q6_k

# Your LLM API key (leave empty in the example)
LLM_API_KEY=
